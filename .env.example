# Reference only: AgentCraft does not automatically load .env files.
# Export/set these in the terminal that starts Foreman. Never commit real credentials.
AGENTCRAFT_PROVIDER=minimax
MINIMAX_API_KEY=<your-MiniMax-Coding-or-Token-Plan-key>
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
# Optional separate models (CLI --lead-model / --worker-model take priority):
# MINIMAX_LEAD_MODEL=MiniMax-M3
# MINIMAX_WORKER_MODEL=MiniMax-M3
